headers = de265_kmp.h
compilerOpts = -std=c11
# libde265 is C++ and links the C++ runtime, pthreads and libm. Kotlin/Native's
# Linux sysroot keeps pthreads in a separate library.
linkerOpts.linux_x64 = -lm -lpthread -lstdc++
linkerOpts.linux_arm64 = -lm -lpthread -lstdc++
linkerOpts.mingw_x64 = -lm -lstdc++ -lwinpthread -static -static-libgcc
linkerOpts.macos_x64 = -lm -lc++
linkerOpts.macos_arm64 = -lm -lc++
linkerOpts.ios_arm64 = -lm -lc++
linkerOpts.ios_x64 = -lm -lc++
linkerOpts.ios_simulator_arm64 = -lm -lc++
linkerOpts.tvos_arm64 = -lm -lc++
linkerOpts.tvos_simulator_arm64 = -lm -lc++
linkerOpts.watchos_arm64 = -lm -lc++
linkerOpts.watchos_simulator_arm64 = -lm -lc++
linkerOpts.watchos_device_arm64 = -lm -lc++
linkerOpts.android_arm64 = -lm -lc++_shared
linkerOpts.android_arm32 = -lm -lc++_shared
linkerOpts.android_x64 = -lm -lc++_shared
linkerOpts.android_x86 = -lm -lc++_shared
